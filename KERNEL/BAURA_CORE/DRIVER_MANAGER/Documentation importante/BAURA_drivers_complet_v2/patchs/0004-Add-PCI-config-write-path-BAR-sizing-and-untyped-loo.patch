diff --git a/BOOT/SEL4/pci_bar.c b/BOOT/SEL4/pci_bar.c
new file mode 100644
index 0000000..1cd13b8
--- /dev/null
+++ b/BOOT/SEL4/pci_bar.c
@@ -0,0 +1,142 @@
+#include "pci_bar.h"
+
+#define CFG_ID 0x00u
+#define CFG_COMMAND 0x04u
+#define CFG_HEADER 0x0Cu
+#define CFG_BAR0 0x10u
+#define CMD_DECODE_MASK 0x0003u /* I/O space (bit 0) and memory space (bit 1) */
+
+typedef struct {
+    const BauraPciCfgOps *ops;
+    uint8_t bus, slot, function;
+} Fn;
+
+static int rd(const Fn *f, uint8_t off, uint32_t *v) {
+    return f->ops->read(f->bus, f->slot, f->function, off, v, f->ops->context);
+}
+static int wr(const Fn *f, uint8_t off, uint32_t v) {
+    return f->ops->write(f->bus, f->slot, f->function, off, v, f->ops->context);
+}
+/* Restoring original values matters more than anything else here, so a failed
+ * restore is retried once before it is reported. */
+static int wr_restore(const Fn *f, uint8_t off, uint32_t v) {
+    return wr(f, off, v) || wr(f, off, v);
+}
+
+/* Writes all ones to one BAR dword, reads the result, then restores `orig`.
+ * Returns 1 only if every access succeeded; the restore is attempted anyway. */
+static int probe_dword(const Fn *f, uint8_t off, uint32_t orig, uint32_t *mask) {
+    int ok = wr(f, off, 0xFFFFFFFFu);
+    ok = ok && rd(f, off, mask);
+    if (!wr_restore(f, off, orig)) ok = 0;
+    return ok;
+}
+
+BauraStatus baura_pci_bar_probe(const BauraPciCfgOps *ops, uint8_t bus, uint8_t slot,
+                                uint8_t function, BauraPciBar bars[6]) {
+    Fn f;
+    uint32_t id, header, command_dword, orig[6], i;
+    BauraStatus status = BAURA_OK;
+    int restored_command = 0;
+
+    if (ops == 0 || ops->read == 0 || ops->write == 0 || bars == 0 ||
+        slot >= 32u || function >= 8u)
+        return BAURA_ERR_INVALID_ARGUMENT;
+    f.ops = ops; f.bus = bus; f.slot = slot; f.function = function;
+    for (i = 0; i < 6u; ++i) {
+        bars[i].kind = BAURA_BAR_NONE; bars[i].index = (uint8_t)i;
+        bars[i].prefetchable = 0; bars[i].base = 0; bars[i].size = 0;
+    }
+
+    if (!rd(&f, CFG_ID, &id) || !rd(&f, CFG_HEADER, &header) ||
+        !rd(&f, CFG_COMMAND, &command_dword))
+        return BAURA_ERR_IO;
+    if ((id & 0xFFFFu) == 0xFFFFu) return BAURA_ERR_INVALID_STATE; /* absent */
+    if (((header >> 16) & 0x7Fu) != 0) return BAURA_ERR_INVALID_STATE; /* not type 0 */
+    for (i = 0; i < 6u; ++i)
+        if (!rd(&f, (uint8_t)(CFG_BAR0 + 4u * i), &orig[i])) return BAURA_ERR_IO;
+
+    /* Bits 31:16 of this dword are the status register, whose bits are
+     * write-one-to-clear: always write the status half as zero. */
+    command_dword &= 0xFFFFu;
+    if (!wr(&f, CFG_COMMAND, command_dword & ~CMD_DECODE_MASK)) return BAURA_ERR_IO;
+
+    for (i = 0; i < 6u && status == BAURA_OK; ++i) {
+        uint8_t off = (uint8_t)(CFG_BAR0 + 4u * i);
+        uint32_t mask;
+        if (orig[i] & 1u) { /* I/O space */
+            if (!probe_dword(&f, off, orig[i], &mask)) { status = BAURA_ERR_IO; break; }
+            mask &= ~3u;
+            if (mask == 0) continue;
+            {
+                uint32_t size = (~mask + 1u);
+                if ((mask >> 16) == 0) size &= 0xFFFFu; /* 16-bit I/O BAR */
+                bars[i].kind = BAURA_BAR_IO;
+                bars[i].base = orig[i] & ~3u;
+                bars[i].size = size;
+            }
+        } else {
+            uint32_t type = (orig[i] >> 1) & 3u;
+            uint8_t prefetch = (uint8_t)((orig[i] >> 3) & 1u);
+            if (type == 3u) continue; /* reserved encoding: ignore */
+            if (type == 2u) {         /* 64-bit memory BAR */
+                uint32_t hi_orig, lo_mask, hi_mask;
+                if (i == 5u) { status = BAURA_ERR_INVALID_STATE; break; }
+                hi_orig = orig[i + 1u];
+                if (!probe_dword(&f, off, orig[i], &lo_mask) ||
+                    !probe_dword(&f, (uint8_t)(off + 4u), hi_orig, &hi_mask)) {
+                    status = BAURA_ERR_IO; break;
+                }
+                lo_mask &= ~0xFu;
+                if (lo_mask == 0 && hi_mask == 0) { ++i; continue; }
+                bars[i].kind = BAURA_BAR_MEM64;
+                bars[i].prefetchable = prefetch;
+                bars[i].base = ((uint64_t)hi_orig << 32) | (orig[i] & ~0xFu);
+                if (hi_mask == 0) {
+                    bars[i].size = (uint64_t)(uint32_t)(~lo_mask + 1u);
+                    if (bars[i].size == 0) bars[i].size = UINT64_C(1) << 32;
+                } else {
+                    uint64_t m = ((uint64_t)hi_mask << 32) | lo_mask;
+                    bars[i].size = ~m + 1u;
+                }
+                ++i; /* the upper dword belongs to this BAR; stays NONE */
+            } else {                  /* 32-bit memory BAR (type 1 = below 1 MiB) */
+                if (!probe_dword(&f, off, orig[i], &mask)) { status = BAURA_ERR_IO; break; }
+                mask &= ~0xFu;
+                if (mask == 0) continue;
+                bars[i].kind = BAURA_BAR_MEM32;
+                bars[i].prefetchable = prefetch;
+                bars[i].base = orig[i] & ~0xFu;
+                bars[i].size = (uint32_t)(~mask + 1u);
+            }
+        }
+    }
+
+    restored_command = wr_restore(&f, CFG_COMMAND, command_dword);
+    if (!restored_command && status == BAURA_OK) status = BAURA_ERR_IO;
+    if (status != BAURA_OK) {
+        for (i = 0; i < 6u; ++i) {
+            bars[i].kind = BAURA_BAR_NONE; bars[i].base = 0; bars[i].size = 0;
+            bars[i].prefetchable = 0;
+        }
+    }
+    return status;
+}
+
+int baura_untyped_find_device(const BauraUntypedDesc *list, uint32_t count,
+                              uint64_t base, uint64_t size) {
+    uint32_t i;
+    uint64_t end;
+    if (list == 0 || size == 0) return -1;
+    end = base + size;
+    if (end < base) return -1; /* wraps around */
+    for (i = 0; i < count; ++i) {
+        uint64_t ut_size, ut_end;
+        if (!list[i].is_device || list[i].size_bits >= 63u) continue;
+        ut_size = UINT64_C(1) << list[i].size_bits;
+        ut_end = list[i].paddr + ut_size;
+        if (ut_end < list[i].paddr) continue;
+        if (base >= list[i].paddr && end <= ut_end) return (int)i;
+    }
+    return -1;
+}
diff --git a/BOOT/SEL4/pci_bar.h b/BOOT/SEL4/pci_bar.h
new file mode 100644
index 0000000..6accd2d
--- /dev/null
+++ b/BOOT/SEL4/pci_bar.h
@@ -0,0 +1,72 @@
+#ifndef BAURA_PCI_BAR_H
+#define BAURA_PCI_BAR_H
+
+/*
+ * PCI BAR sizing and untyped lookup. Portable: configuration access is
+ * injected, there is no seL4 dependency. Mapping the resulting range into an
+ * address space is NOT done here (see DRIVER_DOCS/09_BAR_ET_MAPPING.md).
+ *
+ * Sizing follows the usual PCI procedure: disable memory and I/O decoding in
+ * the command register, write all ones to the BAR, read it back, restore the
+ * BAR, restore the command register. Only header type 0 functions are sized.
+ * Sizing briefly disables decoding of the device: do not size a device the
+ * firmware or another agent is actively using (see the document above).
+ */
+
+#include <stdint.h>
+
+#include "../../KERNEL/BAURA_CORE/baura_core_types.h"
+
+typedef struct {
+    /* Return 1 on success, 0 on failure; offset is dword-aligned. */
+    int (*read)(uint8_t bus, uint8_t slot, uint8_t function, uint8_t offset,
+                uint32_t *value, void *context);
+    int (*write)(uint8_t bus, uint8_t slot, uint8_t function, uint8_t offset,
+                 uint32_t value, void *context);
+    void *context;
+} BauraPciCfgOps;
+
+typedef enum {
+    BAURA_BAR_NONE = 0,   /* not implemented, or the upper half of a 64-bit BAR */
+    BAURA_BAR_MEM32 = 1,
+    BAURA_BAR_MEM64 = 2,
+    BAURA_BAR_IO = 3
+} BauraBarKind;
+
+typedef struct {
+    BauraBarKind kind;
+    uint8_t index;          /* index of the (first) BAR dword, 0-5 */
+    uint8_t prefetchable;
+    uint64_t base;          /* as programmed by the firmware; 0 = unassigned */
+    uint64_t size;          /* bytes; 0 when kind is NONE */
+} BauraPciBar;
+
+/*
+ * Sizes the six BARs of a header-type-0 function and fills `bars` (6 entries,
+ * indexed by BAR dword; the upper dword of a 64-bit BAR is reported as NONE).
+ * On any configuration access failure it makes a best effort to restore the
+ * original BAR and command values and returns BAURA_ERR_IO. Returns
+ * BAURA_ERR_INVALID_ARGUMENT for null arguments, BAURA_ERR_INVALID_STATE for a
+ * header type other than 0 or an invalid 64-bit BAR in the last slot.
+ */
+BauraStatus baura_pci_bar_probe(const BauraPciCfgOps *ops, uint8_t bus, uint8_t slot,
+                                uint8_t function, BauraPciBar bars[6]);
+
+/* One entry of seL4_BootInfo.untypedList, flattened. */
+typedef struct {
+    uint64_t paddr;
+    uint8_t size_bits;
+    uint8_t is_device;
+} BauraUntypedDesc;
+
+/*
+ * Finds the device untyped that fully contains [base, base+size). Returns its
+ * index in `list` or -1. The range must be non-empty, not wrap around, and
+ * the untyped must be a device untyped. This only answers "which untyped",
+ * not how to carve it (objects inside an untyped are allocated in order; see
+ * the document).
+ */
+int baura_untyped_find_device(const BauraUntypedDesc *list, uint32_t count,
+                              uint64_t base, uint64_t size);
+
+#endif
diff --git a/BOOT/tests/pci_bar_test.c b/BOOT/tests/pci_bar_test.c
new file mode 100644
index 0000000..1b72283
--- /dev/null
+++ b/BOOT/tests/pci_bar_test.c
@@ -0,0 +1,186 @@
+/*
+ * Host tests for BAR sizing and untyped lookup, plus the port-backend write.
+ * The fake device models BAR registers: bits below the size granularity read
+ * as zero after an all-ones write, flag bits are read-only, and the status
+ * half of the command dword is write-one-to-clear.
+ */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "../SEL4/pci_bar.h"
+#include "../SEL4/pci_backend.h"
+
+typedef struct {
+    uint32_t cfg[64];
+    uint32_t bar_mask[6];   /* writable bits of each BAR dword */
+    uint32_t bar_ro[6];     /* read-only flag bits */
+    uint32_t status;        /* status register (bits 31:16 of dword 1) */
+    unsigned writes;
+    int fail_write_after;   /* fail the Nth write (1-based); 0 = never */
+    int fail_all_reads;
+    int decode_was_enabled_during_sizing;
+} Dev;
+
+static int dev_read(uint8_t b, uint8_t s, uint8_t f, uint8_t off, uint32_t *v, void *c) {
+    Dev *d = c; (void)b; (void)s; (void)f;
+    if (d->fail_all_reads) return 0;
+    *v = d->cfg[off / 4u];
+    if (off == 4u) *v = (d->cfg[1] & 0xFFFFu) | (d->status << 16);
+    return 1;
+}
+
+static int dev_write(uint8_t b, uint8_t s, uint8_t f, uint8_t off, uint32_t v, void *c) {
+    Dev *d = c; (void)b; (void)s; (void)f;
+    ++d->writes;
+    if (d->fail_write_after && (int)d->writes == d->fail_write_after) return 0;
+    if (off == 4u) {
+        d->status &= ~(v >> 16);               /* write-one-to-clear */
+        d->cfg[1] = v & 0xFFFFu;
+    } else if (off >= 0x10u && off < 0x28u) {
+        unsigned i = (off - 0x10u) / 4u;
+        if (v == 0xFFFFFFFFu && (d->cfg[1] & 3u) != 0)
+            d->decode_was_enabled_during_sizing = 1;
+        d->cfg[off / 4u] = (v & d->bar_mask[i]) | d->bar_ro[i];
+    }
+    return 1;
+}
+
+static void dev_init(Dev *d) {
+    memset(d, 0, sizeof *d);
+    d->cfg[0] = 0x100e8086u;
+    d->cfg[1] = 0x0007u;       /* I/O, memory, bus master enabled */
+    d->status = 0x0210u;       /* some write-one-to-clear bits set */
+    d->cfg[3] = 0x00000000u;   /* header type 0 */
+}
+
+static BauraPciCfgOps ops_for(Dev *d) {
+    BauraPciCfgOps o; o.read = dev_read; o.write = dev_write; o.context = d; return o;
+}
+
+static void test_mem32_io_and_restore(void) {
+    Dev d; BauraPciCfgOps o; BauraPciBar bars[6];
+    dev_init(&d); o = ops_for(&d);
+    /* BAR0: 128 KiB prefetchable-less 32-bit memory at 0xFEBC0000 */
+    d.bar_mask[0] = 0xFFFE0000u; d.bar_ro[0] = 0x0; d.cfg[4] = 0xFEBC0000u;
+    /* BAR1: 64-byte I/O at 0xC040 */
+    d.bar_mask[1] = 0xFFFFFFC0u; d.bar_ro[1] = 0x1; d.cfg[5] = 0xC041u;
+    assert(baura_pci_bar_probe(&o, 0, 3, 0, bars) == BAURA_OK);
+    assert(bars[0].kind == BAURA_BAR_MEM32 && bars[0].size == 0x20000u &&
+           bars[0].base == 0xFEBC0000u && !bars[0].prefetchable);
+    assert(bars[1].kind == BAURA_BAR_IO && bars[1].size == 0x40u && bars[1].base == 0xC040u);
+    assert(bars[2].kind == BAURA_BAR_NONE);
+    /* everything restored, including the write-one-to-clear status bits */
+    assert(d.cfg[4] == 0xFEBC0000u && d.cfg[5] == 0xC041u);
+    assert(d.cfg[1] == 0x0007u);
+    assert(d.status == 0x0210u);          /* status was not cleared */
+    assert(!d.decode_was_enabled_during_sizing);
+}
+
+static void test_mem64(void) {
+    Dev d; BauraPciCfgOps o; BauraPciBar bars[6];
+    dev_init(&d); o = ops_for(&d);
+    /* BAR2/3: 64-bit prefetchable, 16 MiB at 0x1_E000_0000 */
+    d.bar_mask[2] = 0xFF000000u; d.bar_ro[2] = 0xCu; d.cfg[6] = 0xE000000Cu;
+    d.bar_mask[3] = 0xFFFFFFFFu; d.cfg[7] = 0x1u;
+    assert(baura_pci_bar_probe(&o, 0, 4, 0, bars) == BAURA_OK);
+    assert(bars[2].kind == BAURA_BAR_MEM64 && bars[2].prefetchable);
+    assert(bars[2].size == 0x1000000u && bars[2].base == 0x1E0000000ull);
+    assert(bars[3].kind == BAURA_BAR_NONE);
+    assert(d.cfg[6] == 0xE000000Cu && d.cfg[7] == 1u);
+    /* 64-bit BAR whose upper half is not implemented (reads back 0) */
+    dev_init(&d); o = ops_for(&d);
+    d.bar_mask[0] = 0xFFF00000u; d.bar_ro[0] = 0x4u; d.cfg[4] = 0xFE000004u;
+    d.bar_mask[1] = 0u;
+    assert(baura_pci_bar_probe(&o, 0, 4, 0, bars) == BAURA_OK);
+    assert(bars[0].kind == BAURA_BAR_MEM64 && bars[0].size == 0x100000u);
+}
+
+static void test_errors_and_restore(void) {
+    Dev d; BauraPciCfgOps o; BauraPciBar bars[6];
+    int n;
+    dev_init(&d); o = ops_for(&d);
+    assert(baura_pci_bar_probe(0, 0, 0, 0, bars) == BAURA_ERR_INVALID_ARGUMENT);
+    assert(baura_pci_bar_probe(&o, 0, 32, 0, bars) == BAURA_ERR_INVALID_ARGUMENT);
+    assert(baura_pci_bar_probe(&o, 0, 0, 8, bars) == BAURA_ERR_INVALID_ARGUMENT);
+    /* absent function */
+    d.cfg[0] = 0xFFFFFFFFu;
+    assert(baura_pci_bar_probe(&o, 0, 1, 0, bars) == BAURA_ERR_INVALID_STATE);
+    /* bridge (header type 1) is refused without any write */
+    dev_init(&d); o = ops_for(&d); d.cfg[3] = 0x00010000u;
+    assert(baura_pci_bar_probe(&o, 0, 1, 0, bars) == BAURA_ERR_INVALID_STATE);
+    assert(d.writes == 0);
+    /* read failure before any write */
+    dev_init(&d); o = ops_for(&d); d.fail_all_reads = 1;
+    assert(baura_pci_bar_probe(&o, 0, 1, 0, bars) == BAURA_ERR_IO && d.writes == 0);
+    /* 64-bit BAR in the last slot is invalid; state still restored */
+    dev_init(&d); o = ops_for(&d);
+    d.bar_mask[5] = 0xFFFFFFF0u; d.cfg[9] = 0x4u; d.bar_ro[5] = 0x4u;
+    assert(baura_pci_bar_probe(&o, 0, 1, 0, bars) == BAURA_ERR_INVALID_STATE);
+    assert(d.cfg[1] == 7u && d.cfg[9] == 4u);
+    /* a failing write at every possible position never leaves decode off
+     * silently: either the whole call succeeds or the original values are back
+     * (command restore is the final write, so only a failure of that very
+     * write can leave decoding disabled, and it is reported as an error) */
+    for (n = 1; n <= 12; ++n) {
+        BauraStatus st;
+        dev_init(&d); o = ops_for(&d);
+        d.bar_mask[0] = 0xFFFE0000u; d.cfg[4] = 0xFEBC0000u;
+        d.fail_write_after = n;
+        st = baura_pci_bar_probe(&o, 0, 3, 0, bars);
+        if (st == BAURA_OK) continue;
+        assert(st == BAURA_ERR_IO);
+        assert(d.cfg[4] == 0xFEBC0000u);
+        assert(bars[0].kind == BAURA_BAR_NONE);
+    }
+}
+
+static void test_untyped(void) {
+    BauraUntypedDesc u[3];
+    u[0].paddr = 0x100000; u[0].size_bits = 20; u[0].is_device = 0;   /* RAM */
+    u[1].paddr = 0xFEBC0000ull; u[1].size_bits = 17; u[1].is_device = 1;
+    u[2].paddr = 0xFD000000ull; u[2].size_bits = 24; u[2].is_device = 1;
+    assert(baura_untyped_find_device(u, 3, 0xFEBC0000ull, 0x20000u) == 1);
+    assert(baura_untyped_find_device(u, 3, 0xFEBC0000ull, 0x20001u) == -1);
+    assert(baura_untyped_find_device(u, 3, 0xFD100000ull, 0x1000u) == 2);
+    assert(baura_untyped_find_device(u, 3, 0x100000ull, 0x1000u) == -1); /* RAM */
+    assert(baura_untyped_find_device(u, 3, 0, 0) == -1);
+    assert(baura_untyped_find_device(u, 3, UINT64_MAX - 1, 16) == -1);   /* wraps */
+    assert(baura_untyped_find_device(0, 0, 0xFD000000ull, 16) == -1);
+}
+
+/* The port backend write path, against a trivial fake of ports 0xCF8/0xCFC. */
+typedef struct { uint32_t address; uint32_t data_written; uint32_t address_at_write; int writes; } Ports;
+static BauraStatus p_out(void *c, uint16_t port, uint32_t v) {
+    Ports *p = c;
+    if (port == BAURA_PCI_CONFIG_ADDRESS_PORT) p->address = v;
+    else { p->data_written = v; p->address_at_write = p->address; ++p->writes; }
+    return BAURA_OK;
+}
+static BauraStatus p_in(void *c, uint16_t port, uint32_t *v) { (void)c; (void)port; *v = 0; return BAURA_OK; }
+
+static void test_backend_write(void) {
+    Ports p; BauraPciPortIo io; BauraPciPortBackend b;
+    memset(&p, 0, sizeof p);
+    io.out32 = p_out; io.in32 = p_in; io.context = &p;
+    assert(baura_pci_port_backend_init(&b, &io) == BAURA_OK);
+    assert(baura_pci_port_config_write(0, 3, 1, 0x10, 0xDEADBEEFu, &b) == 1);
+    assert(p.data_written == 0xDEADBEEFu);
+    assert(p.address_at_write == baura_pci_config_address(0, 3, 1, 0x10));
+    assert(baura_pci_port_config_write(0, 32, 0, 0x10, 0, &b) == 0);
+    assert(baura_pci_port_config_write(0, 0, 8, 0x10, 0, &b) == 0);
+    assert(baura_pci_port_config_write(0, 0, 0, 0x11, 0, &b) == 0);
+    assert(baura_pci_port_config_write(0, 0, 0, 0x10, 0, 0) == 0);
+    assert(p.writes == 1);
+}
+
+int main(void) {
+    test_mem32_io_and_restore();
+    test_mem64();
+    test_errors_and_restore();
+    test_untyped();
+    test_backend_write();
+    puts("pci_bar_test: all tests passed");
+    return 0;
+}
