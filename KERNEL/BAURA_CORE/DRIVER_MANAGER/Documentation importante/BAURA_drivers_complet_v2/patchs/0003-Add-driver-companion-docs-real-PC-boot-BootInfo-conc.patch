diff --git a/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/bootinfo_chunks.c b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/bootinfo_chunks.c
new file mode 100644
index 0000000..b9efb1f
--- /dev/null
+++ b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/bootinfo_chunks.c
@@ -0,0 +1,44 @@
+#include "bootinfo_chunks.h"
+#include <string.h>
+
+#define HDR 16u /* seL4_BootInfoHeader = deux mots de 64 bits */
+
+int baura_bootinfo_next_chunk(const uint8_t *extra, size_t extra_len,
+                              size_t *offset, BauraBootChunk *out)
+{
+    uint64_t id, len;
+    if (!extra || !offset || !out) return 0;
+    if (*offset > extra_len || extra_len - *offset < HDR) return 0;
+    memcpy(&id, extra + *offset, 8);
+    memcpy(&len, extra + *offset + 8, 8);
+    if (len < HDR || len > extra_len - *offset) return 0;
+    out->id = id;
+    out->len = len;
+    out->payload = extra + *offset + HDR;
+    out->payload_len = (size_t)(len - HDR);
+    *offset += (size_t)len;
+    return 1;
+}
+
+int baura_bootinfo_find_chunk(const uint8_t *extra, size_t extra_len,
+                              uint64_t id, BauraBootChunk *out)
+{
+    size_t off = 0;
+    BauraBootChunk c;
+    while (baura_bootinfo_next_chunk(extra, extra_len, &off, &c)) {
+        if (c.id == id) { *out = c; return 1; }
+    }
+    return 0;
+}
+
+int baura_bootinfo_get_fb(const uint8_t *extra, size_t extra_len,
+                          BauraBootFb *fb)
+{
+    BauraBootChunk c;
+    if (!fb) return 0;
+    if (!baura_bootinfo_find_chunk(extra, extra_len,
+                                   BAURA_BI_ID_X86_FRAMEBUFFER, &c)) return 0;
+    if (c.payload_len < sizeof *fb) return 0;
+    memcpy(fb, c.payload, sizeof *fb);
+    return 1;
+}
diff --git a/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/bootinfo_chunks.h b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/bootinfo_chunks.h
new file mode 100644
index 0000000..8aedb9d
--- /dev/null
+++ b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/bootinfo_chunks.h
@@ -0,0 +1,49 @@
+/* Exemple (proposition) : lecture des chunks "extra" du BootInfo seL4 x86_64.
+ * Portable : travaille sur un tampon d'octets, sans en-tête seL4, donc testable
+ * sur hôte. Voir 02_BOOTINFO_ET_CONSOLE_FRAMEBUFFER.md. */
+#ifndef BAURA_BOOTINFO_CHUNKS_H
+#define BAURA_BOOTINFO_CHUNKS_H
+#include <stddef.h>
+#include <stdint.h>
+
+#define BAURA_BI_ID_PADDING 0u
+#define BAURA_BI_ID_X86_VBE 1u
+#define BAURA_BI_ID_X86_MBMMAP 2u
+#define BAURA_BI_ID_X86_ACPI_RSDP 3u
+#define BAURA_BI_ID_X86_FRAMEBUFFER 4u
+#define BAURA_BI_ID_X86_TSC_FREQ 5u
+#define BAURA_BI_ID_FDT 6u
+
+/* Miroir de multiboot2_fb_t du noyau (défini dans un en-tête interne du noyau,
+ * non exposé à l'espace utilisateur). Disposition packed : 22 octets. */
+typedef struct __attribute__((packed)) {
+    uint64_t addr;
+    uint32_t pitch;
+    uint32_t width;
+    uint32_t height;
+    uint8_t bpp;
+    uint8_t type; /* 0 indexé, 1 RGB direct, 2 texte EGA (à confirmer) */
+} BauraBootFb;
+
+typedef struct {
+    uint64_t id;
+    uint64_t len; /* inclut l'en-tête de 16 octets */
+    const uint8_t *payload;
+    size_t payload_len;
+} BauraBootChunk;
+
+/* Itère sur les chunks. *offset commence à 0. Retourne 1 si un chunk est lu,
+ * 0 à la fin ou si le tampon est incohérent (len < 16, dépassement). Les
+ * en-têtes peuvent être non alignés : lecture par memcpy. */
+int baura_bootinfo_next_chunk(const uint8_t *extra, size_t extra_len,
+                              size_t *offset, BauraBootChunk *out);
+
+/* Cherche le premier chunk d'identifiant `id`. Retourne 1 si trouvé. */
+int baura_bootinfo_find_chunk(const uint8_t *extra, size_t extra_len,
+                              uint64_t id, BauraBootChunk *out);
+
+/* Lit le chunk framebuffer. Retourne 0 si absent ou trop court. */
+int baura_bootinfo_get_fb(const uint8_t *extra, size_t extra_len,
+                          BauraBootFb *fb);
+
+#endif
diff --git a/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/driver_contract.h b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/driver_contract.h
new file mode 100644
index 0000000..f7c8eb6
--- /dev/null
+++ b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/driver_contract.h
@@ -0,0 +1,64 @@
+/* Exemple (proposition) : structures du contrat pilote. N'existe pas encore
+ * dans le Core. Voir 04_INTERFACES_DE_CLASSE.md, 05_MODELE_DE_SECURITE.md et
+ * ../DRIVER_DEVELOPMENT_GUIDE.md §3 et §5. */
+#ifndef BAURA_DRIVER_CONTRACT_H
+#define BAURA_DRIVER_CONTRACT_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* Accès matériel donné à un pilote : le pilote n'appelle jamais seL4 lui-même. */
+typedef struct BauraHwAccess {
+    void *ctx;
+    uint32_t (*io_in)(void *ctx, uint16_t port, unsigned width_bytes);
+    int (*io_out)(void *ctx, uint16_t port, unsigned width_bytes, uint32_t v);
+    /* BAR mappé (CacheDisabled sauf mention contraire) ; NULL si refusé. */
+    volatile void *(*map_bar)(void *ctx, unsigned bar, size_t *len);
+    /* Tampon DMA contigu : adresse virtuelle ET adresse bus. */
+    int (*dma_alloc)(void *ctx, size_t len, void **virt, uint64_t *bus);
+    void (*dma_free)(void *ctx, void *virt);
+    /* Attend une IRQ ; timeout_us==0 : non bloquant. 0 = reçue, 1 = délai. */
+    int (*irq_wait)(void *ctx, uint32_t timeout_us);
+    void (*irq_ack)(void *ctx);
+    void (*delay_us)(void *ctx, uint32_t us);
+} BauraHwAccess;
+
+/* Opérations d'un pilote chargé. */
+typedef struct BauraDriverOps {
+    int (*probe)(void *drv, const BauraHwAccess *hw);  /* 0 = prend l'appareil */
+    int (*start)(void *drv);
+    void (*stop)(void *drv);                           /* libère tout */
+} BauraDriverOps;
+
+typedef enum {
+    BAURA_BIND_NONE = 0, BAURA_BIND_CANDIDATE, BAURA_BIND_PROBING,
+    BAURA_BIND_BOUND, BAURA_BIND_FAILED, BAURA_BIND_QUARANTINED
+} BauraBindState;
+
+/* Entrée de table de correspondance, du plus précis au plus général. */
+typedef struct {
+    uint16_t vendor, device;       /* 0xFFFF = joker */
+    uint16_t sub_vendor, sub_dev;  /* 0xFFFF = joker */
+    uint8_t cls, subcls, prog_if;  /* 0xFF = joker */
+    uint8_t rev_min, rev_max;
+} BauraMatchEntry;
+
+#define BAURA_ANY16 0xFFFFu
+#define BAURA_ANY8 0xFFu
+
+/* Points de précision : plus la valeur est haute, plus la règle est précise. */
+static inline int baura_match_score(const BauraMatchEntry *m, uint16_t ven,
+    uint16_t dev, uint16_t sven, uint16_t sdev, uint8_t cls, uint8_t sub,
+    uint8_t pi, uint8_t rev)
+{
+    int s = 0;
+    if (rev < m->rev_min || rev > m->rev_max) return -1;
+    if (m->vendor != BAURA_ANY16) { if (m->vendor != ven) return -1; s += 8; }
+    if (m->device != BAURA_ANY16) { if (m->device != dev) return -1; s += 16; }
+    if (m->sub_vendor != BAURA_ANY16) { if (m->sub_vendor != sven) return -1; s += 4; }
+    if (m->sub_dev != BAURA_ANY16) { if (m->sub_dev != sdev) return -1; s += 4; }
+    if (m->cls != BAURA_ANY8) { if (m->cls != cls) return -1; s += 1; }
+    if (m->subcls != BAURA_ANY8) { if (m->subcls != sub) return -1; s += 1; }
+    if (m->prog_if != BAURA_ANY8) { if (m->prog_if != pi) return -1; s += 1; }
+    return s;
+}
+#endif
diff --git a/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/examples_test.c b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/examples_test.c
new file mode 100644
index 0000000..331ec09
--- /dev/null
+++ b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/examples_test.c
@@ -0,0 +1,53 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "bootinfo_chunks.h"
+#include "spsc_ring.h"
+#include "driver_contract.h"
+#include "virtio_pci.h"
+
+static size_t put(uint8_t *b, size_t o, uint64_t id, const void *p, size_t n)
+{
+    uint64_t len = 16 + n;
+    memcpy(b + o, &id, 8); memcpy(b + o + 8, &len, 8);
+    if (n) memcpy(b + o + 16, p, n);
+    return o + (size_t)len;
+}
+
+int main(void)
+{
+    uint8_t buf[256]; size_t o = 0; BauraBootFb fb, got; BauraBootChunk c;
+    uint8_t odd[5] = {1,2,3,4,5}; /* rend le chunk suivant non aligné */
+    memset(&fb, 0, sizeof fb);
+    fb.addr = 0xFD000000ull; fb.pitch = 4096; fb.width = 1024;
+    fb.height = 768; fb.bpp = 32; fb.type = 1;
+    assert(sizeof fb == 22);
+    o = put(buf, o, BAURA_BI_ID_X86_ACPI_RSDP, odd, sizeof odd);
+    o = put(buf, o, BAURA_BI_ID_X86_FRAMEBUFFER, &fb, sizeof fb);
+    assert(baura_bootinfo_get_fb(buf, o, &got) && got.addr == fb.addr
+           && got.width == 1024 && got.bpp == 32);
+    assert(!baura_bootinfo_find_chunk(buf, o, BAURA_BI_ID_FDT, &c));
+    assert(!baura_bootinfo_get_fb(buf, o - 1, &got));     /* tronqué */
+    { uint64_t bad = 8; memcpy(buf + 8, &bad, 8); }        /* len < 16 */
+    assert(!baura_bootinfo_get_fb(buf, o, &got));
+
+    { BauraSpscRing r; uint8_t in[64], out[64]; unsigned i;
+      memset(&r, 0, sizeof r);
+      for (i = 0; i < BAURA_RING_SLOTS; i++) { memset(in, (int)i, 64);
+          assert(baura_ring_push(&r, in)); }
+      assert(!baura_ring_push(&r, in));                    /* plein */
+      for (i = 0; i < BAURA_RING_SLOTS; i++) { assert(baura_ring_pop(&r, out));
+          assert(out[0] == (uint8_t)i); }
+      assert(!baura_ring_pop(&r, out)); }
+
+    { BauraMatchEntry exact = {0x8086, 0x100e, BAURA_ANY16, BAURA_ANY16,
+                               BAURA_ANY8, BAURA_ANY8, BAURA_ANY8, 0, 255};
+      BauraMatchEntry cls = {BAURA_ANY16, BAURA_ANY16, BAURA_ANY16, BAURA_ANY16,
+                             0x02, BAURA_ANY8, BAURA_ANY8, 0, 255};
+      int a = baura_match_score(&exact, 0x8086, 0x100e, 0, 0, 2, 0, 0, 3);
+      int b = baura_match_score(&cls, 0x8086, 0x100e, 0, 0, 2, 0, 0, 3);
+      assert(a > b && b >= 0);
+      assert(baura_match_score(&exact, 0x10ec, 0x8168, 0, 0, 2, 0, 0, 3) < 0); }
+    puts("driver docs examples: OK");
+    return 0;
+}
diff --git a/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/spsc_ring.h b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/spsc_ring.h
new file mode 100644
index 0000000..acfd605
--- /dev/null
+++ b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/spsc_ring.h
@@ -0,0 +1,41 @@
+/* Exemple (proposition) : anneau SPSC (un producteur, un consommateur) pour la
+ * mémoire partagée entre le Core et un pilote isolé. Capacité = puissance de 2.
+ * Un seul écrivain par indice ; synchronisation par acquire/release.
+ * Voir 03_MODELE_DE_CONCURRENCE.md. */
+#ifndef BAURA_SPSC_RING_H
+#define BAURA_SPSC_RING_H
+#include <stdint.h>
+
+#define BAURA_RING_SLOTS 64u /* puissance de 2 */
+#define BAURA_RING_SLOT_BYTES 64u
+
+typedef struct {
+    uint32_t head; /* écrit par le producteur seulement */
+    uint32_t pad1[15];
+    uint32_t tail; /* écrit par le consommateur seulement */
+    uint32_t pad2[15];
+    uint8_t slot[BAURA_RING_SLOTS][BAURA_RING_SLOT_BYTES];
+} BauraSpscRing;
+
+static inline int baura_ring_push(BauraSpscRing *r, const void *src)
+{
+    uint32_t h = __atomic_load_n(&r->head, __ATOMIC_RELAXED);
+    uint32_t t = __atomic_load_n(&r->tail, __ATOMIC_ACQUIRE);
+    if (h - t >= BAURA_RING_SLOTS) return 0; /* plein */
+    __builtin_memcpy(r->slot[h & (BAURA_RING_SLOTS - 1u)], src,
+                     BAURA_RING_SLOT_BYTES);
+    __atomic_store_n(&r->head, h + 1u, __ATOMIC_RELEASE);
+    return 1;
+}
+
+static inline int baura_ring_pop(BauraSpscRing *r, void *dst)
+{
+    uint32_t t = __atomic_load_n(&r->tail, __ATOMIC_RELAXED);
+    uint32_t h = __atomic_load_n(&r->head, __ATOMIC_ACQUIRE);
+    if (h == t) return 0; /* vide */
+    __builtin_memcpy(dst, r->slot[t & (BAURA_RING_SLOTS - 1u)],
+                     BAURA_RING_SLOT_BYTES);
+    __atomic_store_n(&r->tail, t + 1u, __ATOMIC_RELEASE);
+    return 1;
+}
+#endif
diff --git a/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/virtio_pci.h b/KERNEL/BAURA_CORE/DRIVER_DOCS/examples/virtio_pci.h
