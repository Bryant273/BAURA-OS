    "native_pointer_width_bits": 64,
    "wire_protocol_is_architecture_independent": true,
    "calling_convention": "BAURA_ABI_DEFAULT remains a target-toolchain binding; v2 does not mandate a register/stack convention."
  },
  "ipc_protocol": {
    "name": "BAURA IPC Wire Protocol",
    "version": "2.0",
    "byte_order": "little-endian",
    "encoding": "All integer fields use their specified fixed width, little-endian. Signed integers use two's-complement representation. Payload fields are concatenated in listed order with no alignment padding. Frames are byte sequences; implementations must not serialize native C structs or pointers directly.",
    "header": {
      "size_bytes": 32,
      "fields": [
        {"name": "magic", "offset": 0, "type": "u32", "value": "0x52554142", "bytes_ascii": "BAUR"},
        {"name": "major", "offset": 4, "type": "u16", "value": 2},
        {"name": "minor", "offset": 6, "type": "u16", "value": 0},
        {"name": "kind", "offset": 8, "type": "u16", "values": {"REQUEST": 1, "RESPONSE": 2, "COMPLETION": 3}},
        {"name": "flags", "offset": 10, "type": "u16", "value": 0},
        {"name": "opcode", "offset": 12, "type": "u32"},
        {"name": "request_id", "offset": 16, "type": "u64", "constraint": "Nonzero and unique among outstanding requests from one client."},
        {"name": "payload_bytes", "offset": 24, "type": "u32", "constraint": "Number of bytes following the 32-byte header; excludes out-of-band capability attachments."},
        {"name": "attachment_count", "offset": 28, "type": "u16"},
        {"name": "reserved", "offset": 30, "type": "u16", "value": 0}
      ]
    },
    "framing": {
      "maximum_payload_bytes": 16384,
      "fragmentation": "Not supported in v2. Each operation defines any permitted shared-memory attachments; arbitrary oversized payloads are not implicitly moved to shared memory. The receiver returns BAURA_ERR_INVALID_ARGUMENT for payloads exceeding the limit.",
      "attachments": "Attachments are kernel-transferred capabilities, not integer handles encoded as authority in the payload. The receiver validates the object type and rights required by the operation. Attachment ordinals in payloads are zero-based and must be less than attachment_count.",
      "validation": "Reject bad magic, unsupported major/minor, unknown kind/opcode, nonzero reserved fields or flags, inconsistent payload length, any attachment count not exactly specified for that operation and message direction, and malformed operation payloads. A rejected request must not perform the requested side effect.",
      "capability_authorization": "The caller must hold the service endpoint capability and the operation-specific capability named by the operation contract. The receiving service validates authorization before processing arguments or causing side effects. Transport endpoint capabilities are supplied by the selected L4 binding and are not serialized as pointer values."
    },
    "response_payload": {
      "prefix_size_bytes": 8,
      "fields": [
        {"name": "status", "offset": 0, "type": "u32", "values": {"SUCCESS": 0, "FAILURE": 1, "PENDING": 2}},
        {"name": "error", "offset": 4, "type": "u32", "values": {"SUCCESS_OR_PENDING": 0, "FAILURE": "A nonzero BAURA_ERR_* value"}}
      ],
      "rules": [
        "A RESPONSE echoes the request opcode and request_id.",
        "SUCCESS has error zero and is followed by the operation's success result, if any.",
        "FAILURE has a nonzero error and no operation result bytes or attachments.",
        "PENDING has error zero and no result bytes or attachments; it is allowed only for operations declared non-blocking.",
        "A COMPLETION echoes the opcode and request_id for an earlier PENDING response, is terminal (SUCCESS or FAILURE only), and uses the normal response payload format.",
        "A successful RESPONSE or COMPLETION carries exactly the success-result attachment count declared for that operation. FAILURE and PENDING carry zero attachments.",
        "COMPLETE synchronous requests with RESPONSE; never send both a terminal RESPONSE and a COMPLETION for the same request_id."
      ]
    },
    "strings": {
      "encoding": "UTF-8",
      "format": "u32 byte_length followed by exactly byte_length bytes; no NUL terminator is transmitted.",
      "embedded_nul": "Forbidden; reject any string containing byte 0.",
      "maximum_path_bytes": 255,
      "maximum_string_bytes": 4096,
      "path_format": "Canonical PC/<drive>:/<path> as specified by VFS_SPEC.md. Reject malformed or over-limit paths."
    },
    "shared_memory": {
      "descriptor": "u16 attachment_ordinal, u16 reserved_zero, u64 offset, u64 length",
      "rules": [
        "The range must fit entirely in the attached memory object without integer overflow.",
        "The client retains ownership of the memory object; the attachment grants only the operation-required access for the request lifetime.",
        "The service must validate the transferred capability type, rights, range, and lifetime before accessing memory.",
        "A returned BAURA_BUFFER is represented by a transferred memory capability attachment and a u64 byte length, never by a process-local pointer."
      ]
    },
    "operation_opcodes": {
      "FS-0001": "0x00010001",
      "FS-0002": "0x00010002",
      "PR-0001": "0x00020001",
      "MEM-0001": "0x00030001",
      "NET-0001": "0x00040001"
    },
    "status_values": {"BAURA_STATUS_SUCCESS": 0, "BAURA_STATUS_FAILURE": 1, "BAURA_STATUS_PENDING": 2},
    "error_values": {
      "BAURA_ERR_INVALID_ARGUMENT": "0x1001",
      "BAURA_ERR_INVALID_PATH": "0x1002",
      "BAURA_ERR_NOT_FOUND": "0x1003",
      "BAURA_ERR_ALREADY_EXISTS": "0x1004",
      "BAURA_ERR_PERMISSION": "0x1005",
      "BAURA_ERR_CAPABILITY": "0x1006",
      "BAURA_ERR_UNAVAILABLE": "0x1007",
      "BAURA_ERR_TIMEOUT": "0x1008",
      "BAURA_ERR_NO_MEMORY": "0x1009",
      "BAURA_ERR_IO": "0x100A",
      "BAURA_ERR_INVALID_HANDLE": "0x100B",
      "BAURA_ERR_NOT_SUPPORTED": "0x100C",
      "BAURA_ERR_SECURITY": "0x100D",
      "BAURA_ERR_INTERNAL": "0x100E"
    }
  },
