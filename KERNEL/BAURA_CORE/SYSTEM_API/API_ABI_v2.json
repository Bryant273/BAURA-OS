  "reference_implementable_operations": [
    {
      "id": "FS-0001",
      "domain": "filesystem",
      "concept": {
        "name": "CreateFile",
        "description": "Créer un fichier"
      },
      "api": {
        "name": "Files.Create",
        "signature": "Files.Create(path, options)",
        "parameters": [
          {
            "name": "path",
            "type": "BAURA_PATH",
            "direction": "in",
            "required": true
          },
          {
            "name": "options",
            "type": "BAURA_FLAGS",
            "direction": "in",
            "required": false
          }
        ],
        "return": {
          "type": "BAURA_FILE_HANDLE",
          "semantic": "Handle du fichier créé"
        }
      },
      "abi": {
        "symbol": "BAURA_FS_CREATE",
        "opcode": "0x00010001",
        "calling_convention": "BAURA_ABI_DEFAULT",
        "mechanism": "IPC",
        "target_service": "filesystem.service",
        "parameter_layout": [
          "BAURA_PATH*",
          "BAURA_FLAGS"
        ],
        "return_type": "BAURA_FILE_HANDLE"
      },
      "wire_payload": {
        "request": [
          "u32 path_byte_length",
          "u8 path[path_byte_length] (UTF-8, canonical BAURA path)",
          "u64 options"
        ],
        "response_success": ["u64 file_handle"],
        "request_attachments": 0,
        "response_attachments": 0,
        "option_bits": {"CREATE_NEW": "0x1", "CREATE_ALWAYS": "0x2"},
        "semantics": "options=0 creates only when absent and fails with BAURA_ERR_ALREADY_EXISTS when present. CREATE_NEW has the same exclusive behavior. CREATE_ALWAYS creates when absent and replaces/truncates an existing file. The two named bits are mutually exclusive; all other bits are invalid."
      },
      "requires": {
        "capabilities": [
          "cap.fs.write"
        ],
        "permissions": [
          "filesystem.write"
        ]
      },
      "errors": [
        "BAURA_ERR_INVALID_PATH",
        "BAURA_ERR_PERMISSION",
        "BAURA_ERR_ALREADY_EXISTS",
        "BAURA_ERR_IO"
      ],
      "mappings": {
        "linux_posix": {
          "equivalent": "open()",
          "mapping": [
            "O_CREAT"
          ],
          "translation_required": true
        },
        "windows": {
          "equivalent": "CreateFile()",
          "mapping": [
            "CREATE_NEW",
            "CREATE_ALWAYS"
          ],
          "translation_required": true
        }
      },
      "shell": {
        "command": "create-file",
        "example": "create-file PC/C:/Ahmed/test.txt"
      },
      "execution": {
        "layer": "BAURA Core",
        "kernel_dependency": "L4/seL4 IPC",
        "blocking": false
      },
      "version": "1.0"
    },
    {
      "id": "FS-0002",
      "domain": "filesystem",
      "concept": {
        "name": "ReadFile",
        "description": "Lire des données depuis un fichier"
      },
      "api": {
        "name": "Files.Read",
        "signature": "Files.Read(handle, buffer, size, offset)",
        "parameters": [
          {
            "name": "handle",
            "type": "BAURA_FILE_HANDLE",
            "direction": "in",
            "required": true
          },
          {
            "name": "buffer",
            "type": "BAURA_BUFFER",
            "direction": "out",
            "required": true
          },
          {
            "name": "size",
            "type": "BAURA_SIZE",
            "direction": "in",
            "required": true
          },
          {
            "name": "offset",
            "type": "BAURA_OFFSET",
            "direction": "in",
            "required": false
          }
        ],
        "return": {
          "type": "BAURA_SIZE",
          "semantic": "Nombre d'octets lus"
        }
      },
      "abi": {
        "symbol": "BAURA_FS_READ",
        "opcode": "0x00010002",
        "calling_convention": "BAURA_ABI_DEFAULT",
        "mechanism": "IPC",
        "target_service": "filesystem.service",
        "parameter_layout": [
          "BAURA_FILE_HANDLE",
          "BAURA_BUFFER*",
          "BAURA_SIZE",
          "BAURA_OFFSET"
        ],
        "return_type": "BAURA_SIZE"
      },
      "wire_payload": {
        "request": [
          "u64 file_handle",
          "u64 size (nonzero)",
          "i64 offset (-1 means use and advance the service-maintained sequential cursor; nonnegative means positioned read; values below -1 are invalid)",
          "u16 attachment_ordinal",
          "u16 reserved_zero",
          "u64 buffer_offset (the descriptor length is the request's size field; it is not repeated)"
        ],
        "response_success": ["u64 bytes_read"],
        "request_attachments": 1,
        "response_attachments": 0,
        "attachment_rights": "The client transfers one shared-memory capability writable by filesystem.service for this request. size bytes starting at buffer_offset must fit in the attached object.",
        "semantics": "A nonnegative offset is a positioned read and does not modify the sequential cursor. Offset -1 reads at and advances that cursor. A short read is successful and reports the actual byte count."
      },
      "requires": {
        "capabilities": [
          "cap.fs.read"
        ],
        "permissions": [
          "filesystem.read"
        ]
      },
      "errors": [
        "BAURA_ERR_INVALID_HANDLE",
        "BAURA_ERR_PERMISSION",
        "BAURA_ERR_IO"
      ],
      "mappings": {
        "linux_posix": {
          "equivalent": "read()/pread()",
          "mapping": [
            "read",
            "pread"
          ],
          "translation_required": true
        },
        "windows": {
          "equivalent": "ReadFile()",
          "mapping": [
            "ReadFile"
          ],
          "translation_required": true
        }
      },
      "shell": {
        "command": "read",
        "example": "read PC/C:/Ahmed/test.txt"
      },
      "execution": {
        "layer": "BAURA Core",
        "kernel_dependency": "L4/seL4 IPC + memory mapping",
        "blocking": true
      },
      "version": "1.0"
    },
